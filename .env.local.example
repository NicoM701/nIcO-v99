# Upstash Redis (free tier at https://upstash.com)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Optional: reset stays disabled unless a non-empty secret is configured.
VISITOR_RESET_SECRET=

# Optional dedicated random HMAC key. Falls back to VISITOR_RESET_SECRET, then
# the existing UPSTASH_REDIS_REST_TOKEN so current deployments keep working.
VISITOR_HASH_SECRET=
